ZZK_DEEPSEEK_API_KEY=your_deepseek_api_key
ZZK_DEEPSEEK_BASE_URL=https://api.deepseek.com
ZZK_DEEPSEEK_MODEL=deepseek-chat
ZZK_DEEPSEEK_TIMEOUT_SECONDS=30.0
# knowledge_provider: auto (http then sqlite fallback) | http | sqlite | mock
ZZK_KNOWLEDGE_PROVIDER=auto
ZZK_KNOWLEDGE_BASE_URL=http://127.0.0.1:8000/knowledge
ZZK_KNOWLEDGE_API_KEY=
ZZK_KNOWLEDGE_TIMEOUT_SECONDS=10.0
# sqlite demo DB path (default ~/.zzk/knowledge.db when empty)
ZZK_KNOWLEDGE_SQLITE_PATH=
# duckduckgo = zero-key Instant Answer (not full web search)
# serpapi    = real organic results; set ZZK_SEARCH_API_KEY (recommended for demos)
ZZK_SEARCH_PROVIDER=duckduckgo
ZZK_SEARCH_API_KEY=
ZZK_SEARCH_TIMEOUT_SECONDS=10.0
# prompt_version: v1 (minimal) | v2 (examples + stricter JSON rules, default)
ZZK_PROMPT_VERSION=v2
# enable_user_skills: load ~/.zzk/skills/*.py (also available via --enable-user-skills)
ZZK_ENABLE_USER_SKILLS=false
